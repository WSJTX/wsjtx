# ThreadSanitizer suppressions for cross-cutting classified third-party reports.
#
# Hamlib is statically linked in the TSan prefix, so called_from_lib
# cannot be used for it. Match the SUMMARY functions from the
# classified 4.7.2 reports instead.
#
# Local runs should use the generated baseline:
#   TSAN_OPTIONS=halt_on_error=0:second_deadlock_stack=1:suppressions=/abs/build/tsan-suppressions/tsan.supp
#
# Do not suppress MainWindow::decode, Detector::writeData, or other
# in-tree frames. Those remain the advisory TSan signal.

# Hamlib 4.7.2 cache and routing races.
# Upstream: Hamlib#2146. Remove after the WSJT-X Hamlib pin includes it.
race:rig_set_cache_freq
race:rig_set_cache_mode
race:rig_get_freq
race:rig_get_vfo
race:rig_poll_routine_stop

# Hamlib 4.7.x debug-buffer race during rig_open.
# Match only the known shared buffer; retain visibility for other rig_open races.
race:debugmsgsave2

# Hamlib 4.7 Morse worker stop-flag race.
# Upstream: Hamlib#2109 / backport Hamlib#2126. Remove after that release.
race:morse_data_handler_stop

# Official Boost builds fix queue publication ordering; keep logging reports visible.

# Dependency suppressions that only apply to Fortran-backed, network, or GUI tests
# live in tsan-fortran.supp, tsan-network.supp, and tsan-gui.supp. CMake
# combines each scope file with this baseline before assigning TSAN_OPTIONS.
