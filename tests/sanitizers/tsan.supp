# ThreadSanitizer suppressions for classified third-party reports.
#
# Hamlib is statically linked in the TSan prefix, so called_from_lib
# cannot be used for it. Match the SUMMARY functions from the
# classified 4.7.2 reports instead.
#
# Local runs should use an absolute path:
#   TSAN_OPTIONS=halt_on_error=0:second_deadlock_stack=1:suppressions=/abs/path/tests/sanitizers/tsan.supp
#
# Do not suppress MainWindow::decode, Detector::writeData, or other
# in-tree frames. Those remain the advisory TSan signal.

# Hamlib 4.7.2 cache and routing races.
# Upstream: Hamlib#2146. Remove after the WSJT-X Hamlib pin includes it.
race:rig_set_cache_freq
race:rig_set_cache_mode
race:rig_get_freq
race:rig_get_vfo
race:rig_poll_routine_stop

# Hamlib 4.7 Morse worker stop-flag race.
# Upstream: Hamlib#2109 / backport Hamlib#2126. Remove after that release.
race:morse_data_handler_stop

# Boost.Log 1.83 publishes asynchronous queue nodes with relaxed atomics,
# leaving TSan without a producer/consumer happens-before edge for the
# record payload. Match the queue operations and the resulting attribute
# detachment reports without suppressing application logging frames.
race:boost::log::v2_mt_posix::aux::threadsafe_queue
race:boost::log::v2_mt_posix::attribute_value::detach_from_thread

# libgfortran I/O-unit lock-order false positive in single-threaded tests.
# Tracked as WSJT-X#292.
deadlock:libgfortran.so

# Qt/DBus lock-order in the uninstrumented system library.
deadlock:libdbus-1.so
