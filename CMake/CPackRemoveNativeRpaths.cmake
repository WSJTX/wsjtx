if (NOT IS_DIRECTORY "${CPACK_TEMPORARY_DIRECTORY}")
  message (FATAL_ERROR "Native package staging directory is missing")
endif ()

cmake_policy (PUSH)
cmake_policy (SET CMP0009 NEW)
file (GLOB_RECURSE staged_files LIST_DIRECTORIES FALSE "${CPACK_TEMPORARY_DIRECTORY}/*")
foreach (path IN LISTS staged_files)
  if (IS_SYMLINK "${path}")
    continue ()
  endif ()
  file (READ "${path}" signature LIMIT 4 HEX)
  if (signature STREQUAL "7f454c46")
    file (RPATH_REMOVE FILE "${path}")
  endif ()
endforeach ()
cmake_policy (POP)
