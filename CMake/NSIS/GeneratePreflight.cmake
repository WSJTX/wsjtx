cmake_minimum_required (VERSION 3.12)

if (NOT IS_DIRECTORY "${STAGING_DIR}" OR NOT OUTPUT_FILE)
  message (FATAL_ERROR "STAGING_DIR and OUTPUT_FILE must identify the staged package and include")
endif ()

file (GLOB_RECURSE entries LIST_DIRECTORIES true RELATIVE "${STAGING_DIR}" "${STAGING_DIR}/*")
set (directories "")
set (files Uninstall.exe bin/jt9stream.exe)
foreach (entry IN LISTS entries)
  if (IS_DIRECTORY "${STAGING_DIR}/${entry}")
    list (APPEND directories "${entry}")
  elseif (EXISTS "${STAGING_DIR}/${entry}")
    list (APPEND files "${entry}")
  else ()
    message (FATAL_ERROR "Cannot represent staged path in preflight: ${entry}")
  endif ()
endforeach ()
list (APPEND directories bin)
list (REMOVE_DUPLICATES directories)
list (REMOVE_DUPLICATES files)
list (SORT directories)
list (SORT files)

function (append_check path kind)
  string (REPLACE "/" "\\" path "${path}")
  string (REPLACE "$" "$$" path "${path}")
  string (REPLACE "\"" "$\\\"" path "${path}")
  file (APPEND "${OUTPUT_FILE}" "  Push \"${path}\"\n  Call CheckDestination${kind}\n  StrCmp $PreflightError 0 +2\n    Return\n")
endfunction ()

file (WRITE "${OUTPUT_FILE}" "; Generated from the completed CPack staging tree.\nFunction CheckDestination\n")
append_check ("" Directory)
foreach (directory IN LISTS directories)
  append_check ("${directory}" Directory)
endforeach ()
foreach (path IN LISTS files)
  append_check ("${path}" File)
endforeach ()
file (APPEND "${OUTPUT_FILE}" "FunctionEnd\n")
