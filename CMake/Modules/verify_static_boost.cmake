function (wsjt_verify_static_boost)
  set (_pending ${ARGN})
  set (_visited)
  while (_pending)
    list (GET _pending 0 _target)
    list (REMOVE_AT _pending 0)
    if (_target IN_LIST _visited)
      continue ()
    endif ()
    list (APPEND _visited "${_target}")
    if (NOT TARGET "${_target}")
      message (FATAL_ERROR "Missing static Boost target: ${_target}")
    endif ()
    get_target_property (_type "${_target}" TYPE)
    if (_type STREQUAL "SHARED_LIBRARY" OR _type STREQUAL "MODULE_LIBRARY")
      message (FATAL_ERROR "Static Boost requested, but ${_target} is ${_type}")
    endif ()
    if (NOT _type STREQUAL "INTERFACE_LIBRARY")
      get_target_property (_configs "${_target}" IMPORTED_CONFIGURATIONS)
      set (_locations IMPORTED_LOCATION)
      foreach (_config IN LISTS _configs)
        string (TOUPPER "${_config}" _config)
        list (APPEND _locations "IMPORTED_LOCATION_${_config}")
      endforeach ()
      set (_found FALSE)
      foreach (_property IN LISTS _locations)
        get_target_property (_archive "${_target}" "${_property}")
        if (NOT _archive)
          continue ()
        endif ()
        string (TOLOWER "${_archive}" _lower_archive)
        if (_lower_archive MATCHES "\\.dll\\.a$" OR
            NOT _lower_archive MATCHES "\\.(a|lib)$" OR NOT EXISTS "${_archive}")
          message (FATAL_ERROR "Static Boost requested, but ${_target} uses ${_archive}")
        endif ()
        # A filename alone does not distinguish an archive from a linker script.
        file (READ "${_archive}" _magic LIMIT 8 HEX)
        if (NOT _magic STREQUAL "213c617263683e0a" AND
            NOT _magic STREQUAL "213c7468696e3e0a")
          message (FATAL_ERROR "Not a Boost static archive: ${_archive}")
        endif ()
        message (STATUS "Static ${_target}: ${_archive}")
        set (_found TRUE)
      endforeach ()
      if (NOT _found)
        message (FATAL_ERROR "No static archive location for ${_target}")
      endif ()
    endif ()
    get_target_property (_links "${_target}" INTERFACE_LINK_LIBRARIES)
    string (REGEX MATCHALL "Boost::[A-Za-z0-9_]+" _boost_links "${_links}")
    list (APPEND _pending ${_boost_links})
  endwhile ()
endfunction ()
