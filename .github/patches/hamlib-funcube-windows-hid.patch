+static int funcube_read_report(libusb_device_handle *udh, unsigned char *data,
+                               int length, int *actual_length, int timeout)
+{
+    unsigned char report[65] = { 0 };
+    int ret;
+
+    *actual_length = 0;
+    if (length <= 0 || (size_t)length >= sizeof(report))
+    {
+        return LIBUSB_ERROR_INVALID_PARAM;
+    }
+
+    /* Windows HID may copy and count an extra report-ID byte.
+     * Keep the USB request unchanged while accommodating that extra write.
+     * Remove the workaround after adopting the fix in
+     * https://github.com/libusb/libusb/pull/1965.
+     */
+    ret = libusb_interrupt_transfer(udh, INPUT_ENDPOINT, report, length,
+                                    actual_length, timeout);
+#ifdef _WIN32
+    if (ret == 0 && *actual_length == length + 1)
+    {
+        --*actual_length;
+    }
+#endif
+    if (ret < 0)
+    {
+        return ret;
+    }
+    if (*actual_length != length)
+    {
+        return LIBUSB_ERROR_IO;
+    }
+
+    memcpy(data, report, length);
+    return 0;
+}
