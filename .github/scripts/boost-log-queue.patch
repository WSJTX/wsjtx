Boost.Log queue publication and reclamation ordering.
Upstream: https://github.com/boostorg/log/pull/258

diff --git a/libs/log/src/threadsafe_queue.cpp b/libs/log/src/threadsafe_queue.cpp
index 3ca581c..83c8749 100644
--- a/libs/log/src/threadsafe_queue.cpp
+++ b/libs/log/src/threadsafe_queue.cpp
@@ -132,3 +132,4 @@ private:
     {
-        p->next.store(next, boost::memory_order_relaxed);
+        // Publish payload writes and order this access before node reclamation.
+        p->next.store(next, boost::memory_order_release);
     }
@@ -136,3 +137,3 @@ private:
     {
-        return p->next.load(boost::memory_order_relaxed);
+        return p->next.load(boost::memory_order_acquire);
     }
