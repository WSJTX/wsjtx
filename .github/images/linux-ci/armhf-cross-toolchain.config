CT_CONFIG_VERSION="4"
CT_LOCAL_TARBALLS_DIR="/var/cache/wsjtx-ctng"
CT_PREFIX_DIR="/opt/wsjtx/armhf-toolchain"
# CT_LOG_PROGRESS_BAR is not set
# CT_LOG_FILE_COMPRESS is not set
CT_ARCH_ARM=y
CT_ARCH_ARM_MODE_THUMB=y
CT_OMIT_TARGET_VENDOR=y
CT_ARCH_ARCH="armv7-a+fp"
CT_ARCH_FLOAT_HW=y
CT_KERNEL_LINUX=y
CT_LINUX_V_6_1=y
CT_BINUTILS_V_2_40=y
CT_BINUTILS_LINKER_LD_GOLD=y
CT_BINUTILS_GOLD_THREADS=y
CT_BINUTILS_LD_WRAPPER=y
CT_BINUTILS_PLUGINS=y
CT_GLIBC_V_2_36=y
CT_GLIBC_KERNEL_VERSION_CHOSEN=y
CT_GLIBC_MIN_KERNEL_VERSION="3.2.0"
CT_GCC_V_13=y
CT_CC_GCC_LIBGOMP=y
CT_CC_LANG_CXX=y
CT_CC_LANG_FORTRAN=y
